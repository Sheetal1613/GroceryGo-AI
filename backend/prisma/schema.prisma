generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inventory {
  id           Int       @id @default(autoincrement())
  name         String
  category     String
  quantity     Int
  unit         String
  price        Float
  expiryDate   DateTime?
  purchaseDate DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
